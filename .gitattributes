# Normalize line endings so Prettier's `endOfLine: "lf"` check agrees between
# Windows working copies and Linux CI. Without this (and with core.autocrlf),
# `npm run format:check` reports different file counts locally vs in CI.
* text=auto eol=lf

# Binary assets — never touch these.
*.ttf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
